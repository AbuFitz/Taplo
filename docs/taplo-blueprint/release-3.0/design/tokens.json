{
  "edition": "3.0",
  "fonts": {
    "operational": "Inter Variable 5.3.0",
    "heading": "Manrope Variable 5.3.0",
    "merchant": "curated existing packs preserved; no content loss when look changes"
  },
  "icons": {
    "pack": "Phosphor Core 2.1.1",
    "weight": "regular",
    "size_px": [
      16,
      20,
      24
    ],
    "rule": "one semantic mapping; category art/labels adapt, core navigation never changes meaning"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    48,
    64
  ],
  "touch_minimum": 44,
  "type_px": [
    12,
    14,
    16,
    20,
    24,
    32,
    40
  ],
  "light": {
    "background": "#F7F7F4",
    "surface": "#FFFFFF",
    "text": "#191B20",
    "muted": "#606572",
    "line": "#D8DCE3",
    "accent": "#3457D5",
    "accent_text": "#FFFFFF"
  },
  "dark": {
    "background": "#111316",
    "surface": "#1B1F25",
    "text": "#F3F4F7",
    "muted": "#B3BAC7",
    "line": "#424A58",
    "accent": "#AABEFF",
    "accent_text": "#141C34"
  },
  "popup": {
    "families": [
      "clear",
      "colour_cap",
      "split_tone"
    ],
    "radius_mobile_top": 28,
    "radius_desktop": 24,
    "close_target": 44,
    "brand_limit": "safe cap/accent; body facts and controls neutral"
  },
  "motion": {
    "press_ms": 120,
    "sheet_ms": 220,
    "crossfade_ms": 160,
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "reduced": "remove travel/scale; retain immediate state/focus; no autoplay tour"
  },
  "layout": {
    "mobile_gutter": 20,
    "tablet_gutter": 24,
    "desktop_max": 1240,
    "form_max": 680,
    "sheet_max": 600
  }
}
