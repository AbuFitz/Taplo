      "scope": "business",
      "allow": [
        "calendar.view",
        "calendar.create",
        "calendar.reschedule",
        "calendar.cancel",
        "calendar.reassign",
        "calendar.attendance",
        "availability.view",
        "availability.request",
        "availability.block",
        "availability.manage",
        "customer.name.read",
        "customer.contact.read",
        "customer.notes.restricted.read",
        "customer.export",
        "message.read",
        "message.send",
