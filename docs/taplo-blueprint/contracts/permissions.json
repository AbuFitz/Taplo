      "assigned_case.read",
      "assigned_case.act"
    ],
    "provider_worker": [
      "verified_provider.reconcile"
    ]
  },
  "mandatory_checks": [
    "active principal",
    "same business scope except separately authorised cross-tenant Console",
    "active membership or verified own relationship",
    "resource/location assignment where relevant",
    "field-level projection",
    "capability and lifecycle guard",
    "step-up/dual review where configured",
    "record version",
    "audited reason for privileged action"
  ],
  "no_role_bypasses": [
    "raw payment credentials",
    "unrestricted customer export",
    "self-granted Console scope",
    "provider financial truth",
    "private learner notes by ordinary fulfilment staff"
  ],
  "coarse_roles_status": "Earlier coarse action groups retained as conceptual aliases; granular actions and scope templates below govern new implementation design.",
  "granular_actions": [
    "calendar.view",
    "calendar.create",
    "calendar.reschedule",
    "calendar.cancel",
    "calendar.reassign",
    "calendar.attendance",
