  "formulas": {
    "monthly_cost": "hosting + messaging + integration_fees_borne + support_minutes * support_cost_per_minute + losses_borne + onboarding_amortisation",
    "contribution": "net_revenue - monthly_cost",
    "contribution_margin": "contribution / net_revenue when net_revenue > 0",
    "revenue_for_target_margin": "monthly_cost / (1 - target_margin), target_margin < 1",
    "acquisition_payback_months": "acquisition_cost / monthly_contribution when contribution > 0"
  },
